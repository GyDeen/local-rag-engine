# Optional overrides. See SETUP.md: Environment configuration.
# RAG_LOG_LEVEL=INFO
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_HOST=http://localhost:11434
# RAG_RETRIEVAL_ONLY=0
# RAG_RETRIEVAL_CONCURRENCY=1
# RAG_RETRIEVAL_QUEUE_SIZE=32
# RAG_GENERATION_CONCURRENCY=1
# RAG_GENERATION_QUEUE_SIZE=32
# OLLAMA_NUM_PARALLEL=1
# HF_HUB_OFFLINE=0
# OPENAI_API_KEY=

# Optional corpus settings for the HTTP service. Use container paths with Compose.
# RAG_DOCS_ROOT=data/processed/my-corpus/documents
# RAG_DATABASE_PATH=data/processed/my-corpus/index
# RAG_COLLECTION=my-documents
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_RERANKER=none

# Optional cutoff on ranked chunks used to build evidence.
# RAG_EVIDENCE_RANK_LIMIT=15
